# Application Environment Configuration - Medonivo Health OS

NODE_ENV=development
PORT=4000

# Database Configuration (PostgreSQL)
POSTGRES_USER=medonivo
POSTGRES_PASSWORD=medonivopass
POSTGRES_DB=medonivo_db
DATABASE_URL=postgresql://<db_user>:<db_password>@127.0.0.1:5432/<db_name>?schema=public

# Redis Configuration (Cache & BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Authentication & Security Secrets
JWT_ACCESS_SECRET=<your_jwt_access_secret_min_32_chars>
JWT_REFRESH_SECRET=<your_jwt_refresh_secret_min_32_chars>
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Application Base URLs
CARE_APP_URL=http://localhost:3000
WORKSPACE_APP_URL=http://localhost:3001
CONTROL_APP_URL=http://localhost:3002
API_URL=http://localhost:4000

# OpenAPI / Swagger Settings
SWAGGER_ENABLED=true
SWAGGER_PATH=/docs
