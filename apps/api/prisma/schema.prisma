datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum IdentityType {
  EMAIL_PASSWORD
  PHONE_OTP
  GOOGLE
  SAML_SSO
}

model Tenant {
  id              String           @id @default(uuid())
  name            String
  slug            String           @unique
  status          TenantStatus     @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organizations   Organization[]
  users           User[]
  userRoles       UserRole[]
  auditLogs       AuditLog[]
  services        Service[]
  invoices        Invoice[]
  diagnosticTests DiagnosticTest[]

  @@index([slug, status])
}

model Organization {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branches  Branch[]
  userRoles UserRole[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Branch {
  id                String              @id @default(uuid())
  organizationId    String
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  code              String
  address           String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  departments       Department[]
  staffBranchAccess StaffBranchAccess[]
  userRoles         UserRole[]
  rooms             Room[]
  operatingHours    OperatingHour[]
  appointments      Appointment[]
  diagnosticOrders  DiagnosticOrder[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Department {
  id            String         @id @default(uuid())
  branchId      String
  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name          String
  code          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  staffProfiles StaffProfile[]

  @@unique([branchId, code])
  @@index([branchId])
}

model User {
  id                 String              @id @default(uuid())
  tenantId           String?
  tenant             Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  email              String?
  phoneNumber        String?
  fullName           String
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  passwordCredential PasswordCredential?
  identities         UserIdentity[]
  sessions           Session[]
  deviceSessions     DeviceSession[]
  userRoles          UserRole[]
  staffProfile       StaffProfile?
  patientProfile     PatientProfile?
  auditLogs          AuditLog[]

  @@unique([tenantId, email])
  @@unique([tenantId, phoneNumber])
  @@index([tenantId])
}

model PasswordCredential {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash      String
  algorithm         String    @default("bcrypt")
  salt              String?
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model UserIdentity {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityType IdentityType
  providerId   String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([identityType, providerId])
  @@index([userId])
}

model Session {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String        @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  device       DeviceSession? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  deviceId     String?

  @@index([userId, revokedAt])
}

model DeviceSession {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String
  deviceName String?
  ipAddress  String?
  userAgent  String?
  lastActive DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  sessions   Session[]

  @@unique([userId, deviceId])
  @@index([userId])
}

model Role {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  description     String?
  isSystemRole    Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  invitations     StaffInvitation[]
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  module          String
  action          String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@index([module, action])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
}

model UserRole {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId         String
  role           Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenantId       String?
  tenant         Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([userId, roleId, tenantId, branchId])
  @@index([userId, tenantId])
}

model StaffProfile {
  id                String              @id @default(uuid())
  userId            String              @unique
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffCode         String
  designation       String?
  departmentId      String?
  department        Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  status            StaffStatus         @default(ACTIVE)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  staffBranchAccess StaffBranchAccess[]
  doctorProfile     DoctorProfile?
  approvedResults   DiagnosticResult[]  @relation("ApprovedPathologist")
  shifts            CashierShift[]

  @@index([staffCode, status])
}

model StaffBranchAccess {
  id             String       @id @default(uuid())
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@unique([staffProfileId, branchId])
}

model StaffInvitation {
  id          String           @id @default(uuid())
  tenantId    String
  email       String
  phoneNumber String?
  roleId      String
  role        Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([tenantId, email, token])
}

model LoginAttempt {
  id            String   @id @default(uuid())
  identifier    String
  ipAddress     String?
  userAgent     String?
  success       Boolean
  failureReason String?
  attemptedAt   DateTime @default(now())

  @@index([identifier, attemptedAt])
}

model AuditLog {
  id             String   @id @default(uuid())
  tenantId       String?
  tenant         Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  organizationId String?
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  entityName     String
  entityId       String
  ipAddress      String?
  userAgent      String?
  details        Json?
  createdAt      DateTime @default(now())

  @@index([tenantId, action])
  @@index([entityName, entityId])
}

model Room {
  id        String   @id @default(uuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String
  code      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, code])
  @@index([branchId])
}

model OperatingHour {
  id        String   @id @default(uuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dayOfWeek Int      // 0 = Sunday, 6 = Saturday
  openTime  String   // HH:mm
  closeTime String   // HH:mm
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, dayOfWeek])
  @@index([branchId])
}

model Service {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  code           String
  basePrice      Int           // minor unit, BDT Paisa
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}

model PatientProfile {
  id                       String              @id @default(uuid())
  userId                   String              @unique
  user                     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  mrn                      String              @unique // Medical Record Number
  dateOfBirth              DateTime
  gender                   String
  bloodGroup               String?
  address                  String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  consentActive            Boolean             @default(true)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  familyPrimary            FamilyRelationship[] @relation("PrimaryPatient")
  familyRelative           FamilyRelationship[] @relation("RelativePatient")
  appointments             Appointment[]
  diagnosticOrders         DiagnosticOrder[]
  invoices                 Invoice[]
  carePassCard             CarePassCard?
  carePassSubscription     CarePassSubscription?
}

model FamilyRelationship {
  id                        String         @id @default(uuid())
  patientId                 String
  patient                   PatientProfile @relation("PrimaryPatient", fields: [patientId], references: [id], onDelete: Cascade)
  relativeId                String
  relative                  PatientProfile @relation("RelativePatient", fields: [relativeId], references: [id], onDelete: Cascade)
  relationshipType          String         // SPOUSE, CHILD, PARENT, SIBLING, OTHER
  caregiverPermissionActive Boolean        @default(false)
  consentSignedAt           DateTime?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  @@unique([patientId, relativeId])
  @@index([patientId])
  @@index([relativeId])
}

model DoctorProfile {
  id              String           @id @default(uuid())
  staffProfileId  String           @unique
  staffProfile    StaffProfile     @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  specialty       String
  biography       String?
  consultationFee Int              // BDT paisa
  followUpFee     Int              // BDT paisa
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  schedules       DoctorSchedule[]
  leaves          DoctorLeave[]
  appointments    Appointment[]
}

model DoctorSchedule {
  id                  String        @id @default(uuid())
  doctorProfileId     String
  doctorProfile       DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  dayOfWeek           Int           // 0 to 6
  startTime           String        // HH:mm
  endTime             String        // HH:mm
  slotDurationMinutes Int           @default(15)
  roomId              String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([doctorProfileId, dayOfWeek, startTime])
  @@index([doctorProfileId])
}

model DoctorLeave {
  id              String        @id @default(uuid())
  doctorProfileId String
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  startDate       DateTime
  endDate         DateTime
  reason          String?
  isException     Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([doctorProfileId])
}

model Appointment {
  id               String         @id @default(uuid())
  patientId        String
  patient          PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorProfileId  String
  doctorProfile    DoctorProfile  @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  branchId         String
  branch           Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  serviceId        String?
  appointmentDate  DateTime
  startTime        String         // HH:mm
  endTime          String         // HH:mm
  status           String         // PENDING, CHECKED_IN, CANCELLED, COMPLETED, NO_SHOW
  queueToken       String?
  checkedInAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  invoiceItem      InvoiceItem?

  @@index([doctorProfileId, appointmentDate])
  @@index([patientId])
}

model DiagnosticTest {
  id                      String            @id @default(uuid())
  tenantId                String
  tenant                  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                    String
  code                    String
  basePrice               Int               // BDT paisa
  preparationInstructions String?
  isActive                Boolean           @default(true)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  orders                  DiagnosticOrder[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model DiagnosticOrder {
  id             String            @id @default(uuid())
  patientId      String
  patient        PatientProfile    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  testId         String
  test           DiagnosticTest    @relation(fields: [testId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  status         String            // ORDERED, COLLECTED, PROCESSING, COMPLETED, APPROVED
  homeCollection Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  result         DiagnosticResult?
  invoiceItem    InvoiceItem?

  @@index([patientId])
  @@index([branchId])
}

model DiagnosticResult {
  id                String          @id @default(uuid())
  diagnosticOrderId String          @unique
  order             DiagnosticOrder @relation(fields: [diagnosticOrderId], references: [id], onDelete: Cascade)
  resultData        Json
  technicianId      String
  approvedById      String?
  approvedBy        StaffProfile?   @relation("ApprovedPathologist", fields: [approvedById], references: [id], onDelete: SetNull)
  status            String          // DRAFT, APPROVED
  approvedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Invoice {
  id          String        @id @default(uuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId   String
  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  totalAmount Int           // BDT paisa
  paidAmount  Int           // BDT paisa
  dueAmount   Int           // BDT paisa
  status      String        // DRAFT, UNPAID, PARTIALLY_PAID, PAID, VOIDED
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       InvoiceItem[]
  payments    Payment[]

  @@index([tenantId])
  @@index([patientId])
}

model InvoiceItem {
  id                String           @id @default(uuid())
  invoiceId         String
  invoice           Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name              String
  quantity          Int
  unitPrice         Int              // BDT paisa
  totalPrice        Int              // BDT paisa
  appointmentId     String?          @unique
  appointment       Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  diagnosticOrderId String?          @unique
  diagnosticOrder   DiagnosticOrder? @relation(fields: [diagnosticOrderId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
}

model Payment {
  id                   String   @id @default(uuid())
  invoiceId            String
  invoice              Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount               Int      // BDT paisa
  paymentMethod        String   // CASH, CARD, MFS
  transactionReference String?
  createdAt            DateTime @default(now())
}

model CashierShift {
  id             String        @id @default(uuid())
  staffProfileId String
  staff          StaffProfile  @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  startAmount    Int           // BDT paisa
  endAmount      Int?          // BDT paisa
  startedAt      DateTime      @default(now())
  endedAt        DateTime?
  status         String        // OPEN, CLOSED
}

model CarePassCard {
  id           String         @id @default(uuid())
  patientId    String         @unique
  patient      PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  cardNumber   String         @unique
  status       String         // ACTIVE, SUSPENDED
  publicKey    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model CarePassSubscription {
  id                     String         @id @default(uuid())
  patientId              String         @unique
  patient                PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  planName               String
  startDate              DateTime
  endDate                 DateTime
  consultationsRemaining Int
  testDiscountPercent    Int
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
}
